# Copy to .env next to docker-compose.yml. Every kmdn setting can be set
# as KMDN_<PATH>; see docs/specs/13-operations.md#configuration.

# Required: 32 random bytes, base64. Generate with: head -c32 /dev/urandom | base64
# Keep it safe: stored forge, SMTP and AI credentials can't be decrypted without it.
KMDN_SECRET_KEY=

# Where people reach kmdn (sign-in links, webhooks, OAuth callbacks).
KMDN_SERVER_BASE_URL=http://localhost:8080

# With the caddy profile: your domain, and base URL https://<domain>.
# KMDN_DOMAIN=docs.example.com

# With the postgres profile:
# POSTGRES_PASSWORD=change-me
# KMDN_DB_URL=postgres://kmdn:change-me@postgres:5432/kmdn?sslmode=disable

# Email for sign-in links (or set it up later in Admin → Email).
# KMDN_SMTP_HOST=smtp.example.com
# KMDN_SMTP_PORT=587
# KMDN_SMTP_USERNAME=
# KMDN_SMTP_PASSWORD=
# KMDN_SMTP_FROM=kmdn@example.com

# Optional: OpenTelemetry traces.
# KMDN_TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318
